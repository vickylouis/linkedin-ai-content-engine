    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert LinkedIn content editor specialising in Quality Engineering, Software Testing, AI Testing, Automation, LLMs and AI Agents.\n\nYour task is to improve the LinkedIn post based on the quality review.\n\nORIGINAL POST:\n{{ $('Content Generator').item.json.text }}\n\nQUALITY REVIEW:\n{{ $('AI Quality Reviewer').item.json.text }}\n\nInstructions:\n1. Address every relevant improvement suggestion.\n2. Improve technical accuracy, originality, clarity and engagement.\n3. Keep the author's authentic voice: a software testing professional with 9+ years of experience.\n4. Do not invent facts, statistics, sources or personal experiences.\n5. Preserve useful technical explanations and practical QA examples.\n6. Keep the post between 150 and 220 words.\n7. Include a strong opening hook, practical value, a closing question and 3–5 relevant hashtags.\n8. Return only the rewritten LinkedIn post, without explanations or Markdown code fences.",
        "batching": {}
      },
